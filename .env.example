# Copy to .env on the Server. Empty values are rejected. Keep .env private.
# Tailscale's local IPv4 address for the Tailscale listener, never a wildcard.
VOIDSTATION_TAILSCALE_BIND_ADDRESS=
# HTTPS port on that private Tailscale address. Use 443 to omit the port in origin.
VOIDSTATION_PORT=
# Exact local Tailscale DNS name, including the port when VOIDSTATION_PORT is not 443.
VOIDSTATION_ORIGIN=https://name.tailnet.ts.net
# LAN HTTPS on a reserved RFC1918 IPv4 address. No Tailscale needed by LAN clients.
# Set the exact interface and canonical trusted source CIDR, not every private range.
VOIDSTATION_LAN_BIND_ADDRESS=
VOIDSTATION_LAN_HTTPS_PORT=3000
VOIDSTATION_LAN_INTERFACE=
VOIDSTATION_LAN_SOURCE=
# Exact https://LAN_IP:3000. Its IP certificate must be trusted on each client.
VOIDSTATION_LAN_ORIGIN=
# Contains only cert.pem, key.pem, public ca.pem. Never mount the CA signing key.
VOIDSTATION_LAN_TLS_DIRECTORY=/var/lib/voidstation/lan-tls
# Dedicated host directories. See docs/deployment.md for ownership and modes.
VOIDSTATION_AUTH_DIRECTORY=/var/lib/voidstation/auth
VOIDSTATION_TLS_DIRECTORY=/var/lib/voidstation/tls
# Internal dashboard-to-worker token file, owned by UID/GID 1000 and mode 0600.
VOIDSTATION_WORKER_TOKEN_FILE=/var/lib/voidstation/worker-token
# Worker-owned durable state. Keep both out of the application auth directory.
VOIDSTATION_CONVERSATION_DIRECTORY=/var/lib/voidstation/conversations
VOIDSTATION_CREDENTIAL_DIRECTORY=/var/lib/voidstation/worker-credentials
# Existing narrow metrics probe directories.
VOIDSTATION_ROOT_FILESYSTEM_PATH=
VOIDSTATION_DATA_FILESYSTEM_PATH=
VOIDSTATION_DATA_FILESYSTEM_UUID=
