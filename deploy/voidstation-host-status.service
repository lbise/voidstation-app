[Unit]
Description=Record Voidstation host status (reboot, updates, drive health)
After=local-fs.target

[Service]
Type=oneshot
TimeoutStartSec=10min
# Root is needed only for SMART pass-through ioctls. The Dashboard container
# never gains these privileges; it reads the resulting JSON file read-only.
Nice=10
IOSchedulingClass=idle
UMask=0022
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=VOIDSTATION_HOST_STATUS_DIRECTORY=/var/lib/voidstation/host-status
ExecStart=/usr/local/libexec/voidstation-host-status
# smartctl needs raw block and NVMe devices, so /dev stays visible
# (no PrivateDevices) and these two capabilities remain.
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/voidstation/host-status
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
