[Unit]
Description=Voidstation Docker ingress policy
DefaultDependencies=no
After=local-fs.target
Before=docker.service
Before=network-pre.target
PartOf=docker.service

[Service]
Type=oneshot
TimeoutStartSec=30
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=full
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/libexec/voidstation-ingress
RemainAfterExit=yes

[Install]
RequiredBy=docker.service
